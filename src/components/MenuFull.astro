---
const { categories } = Astro.props;

function isOutOfStock(item) {
  if (item?.isOutOfStock) return true;
  return (item?.tags || []).some((tag) => String(tag).trim().toLowerCase() === "out of stock");
}
---
<section class="py-16 bg-background">
  <div class="page-container">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-primary mb-4">Our Menu</h1>
      <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
        Freshly prepared favorites made daily.
      </p>
    </div>

    <div class="space-y-12">
      {(categories || []).map((category) => (
        <section class="card-base bg-section-bg px-4 py-8 md:px-8 md:py-12">
          <div class="text-center">
            {category.image?.asset?.url ? (
              <img
                src={category.image.asset.url}
                alt={category.image.alt || category.title}
                class="mx-auto h-28 w-28 rounded-full object-cover md:h-36 md:w-36"
                loading="lazy"
              />
            ) : (
              <div class="mx-auto h-28 w-28 rounded-full bg-secondary md:h-36 md:w-36"></div>
            )}
            <h2 class="mt-6 text-3xl md:text-5xl font-bold text-primary">{category.title}</h2>
            {category.description ? (
              <p class="mx-auto mt-3 max-w-2xl text-lg text-muted-foreground">{category.description}</p>
            ) : null}
          </div>

          <div class="card-grid mt-10 md:grid-cols-2 lg:grid-cols-3">
            {(category.items || []).map((item) => (
              <article class="card-base bg-background min-h-[190px]">
                <div class="flex items-start justify-between gap-4">
                  <h3 class="card-title leading-tight text-foreground">{item.name}</h3>
                  {item.price ? (
                    <span class="shrink-0 rounded-full bg-secondary px-4 py-1 text-base font-semibold text-accent">
                      {item.price}
                    </span>
                  ) : null}
                </div>

                {item.description ? (
                  <p class="card-body mt-5 leading-relaxed text-muted-foreground">{item.description}</p>
                ) : null}

                {isOutOfStock(item) ? (
                  <span class="mt-5 inline-flex rounded-full border border-border bg-secondary px-4 py-1 text-sm font-semibold text-foreground">
                    Out of Stock
                  </span>
                ) : null}
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>
