---
const { siteTitle } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="bg-primary text-primary-foreground py-10">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between gap-6">
      <div>
        <h2 class="text-2xl font-bold">{siteTitle || "Zoe Take Out & Bakery"}</h2>
        <p class="text-primary-foreground/80 mt-2">Fresh meals and baked goods made daily.</p>
      </div>
      <div class="space-y-2 text-sm">
        <a class="block hover:text-accent" href="/">Home</a>
        <a class="block hover:text-accent" href="/menu">Menu</a>
        <a class="block hover:text-accent" href="/#reservations">Reservations</a>
        <a class="block hover:text-accent" href="/#contact">Contact</a>
      </div>
    </div>
    <div class="border-t border-primary-foreground/20 mt-8 pt-4 text-sm text-primary-foreground/80">
      © {year} {siteTitle || "Zoe Take Out & Bakery"}. All rights reserved.
    </div>
  </div>
</footer>
