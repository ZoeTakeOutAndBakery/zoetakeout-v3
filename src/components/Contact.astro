---
const { contact } = Astro.props;
import { sanitizeMapEmbedUrl } from "../lib/urlSafety.js";

const mapUrl = sanitizeMapEmbedUrl(contact?.mapEmbedUrl);
const fullAddress = [contact?.addressLine1, contact?.addressLine2].filter(Boolean).join(", ");
---
<section id="contact" class="py-14 bg-section-bg">
  <div class="page-container max-w-[1200px]">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold text-primary mb-3">Contact Us</h2>
      <p class="text-muted-foreground text-lg">We would love to hear from you.</p>
    </div>

    <div class="card-grid card-grid-lg items-start lg:grid-cols-[1.1fr_1fr]">
      <div class="space-y-6">
        {contact?.contactPhone ? (
          <div class="card-base bg-section-bg shadow-none">
            <h3 class="card-title mb-4 flex items-center gap-3 leading-none">
              <svg class="h-6 w-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92V20a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3.09a2 2 0 0 1 2 1.72c.12.9.33 1.79.62 2.64a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.44-1.28a2 2 0 0 1 2.11-.45c.85.29 1.74.5 2.64.62A2 2 0 0 1 22 16.92Z"></path>
              </svg>
              Phone
            </h3>
            <p class="card-body leading-tight font-semibold text-primary">{contact.contactPhone}</p>
            <p class="card-meta mt-3">Call us for immediate assistance or to place orders</p>
            <a
              href={`tel:${contact.contactPhone}`}
              class="mt-6 inline-flex items-center justify-center rounded-2xl bg-accent px-6 py-3 text-base font-semibold text-accent-foreground transition-colors hover:bg-accent/90"
            >
              Call Now
            </a>
          </div>
        ) : null}

        {contact?.contactEmail ? (
          <div class="card-base bg-section-bg shadow-none">
            <h3 class="card-title mb-4 flex items-center gap-3 leading-none">
              <svg class="h-6 w-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" ry="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
              </svg>
              Email
            </h3>
            <p class="card-body leading-tight font-semibold text-primary break-all">{contact.contactEmail}</p>
            <p class="card-meta mt-3">Send us an email for catering inquiries and questions</p>
            <a
              href={`mailto:${contact.contactEmail}`}
              class="mt-6 inline-flex items-center justify-center rounded-2xl border border-border bg-background px-6 py-3 text-base font-semibold text-primary transition-colors hover:bg-secondary"
            >
              Send Email
            </a>
          </div>
        ) : null}

        {fullAddress ? (
          <div class="card-base bg-section-bg shadow-none">
            <h3 class="card-title mb-4 flex items-center gap-3 leading-none">
              <svg class="h-6 w-6 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s7-4.35 7-11a7 7 0 1 0-14 0c0 6.65 7 11 7 11Z"></path>
                <circle cx="12" cy="11" r="3"></circle>
              </svg>
              Address
            </h3>
            <p class="card-body leading-tight font-semibold text-primary">{contact.addressLine1}</p>
            {contact?.addressLine2 ? <p class="card-body mt-2 leading-tight font-semibold text-primary">{contact.addressLine2}</p> : null}
            <p class="card-meta mt-3">Come visit us for fresh baked goods daily</p>
          </div>
        ) : null}

        <div class="card-base bg-section-bg shadow-none">
          <h3 class="card-title mb-4 leading-none">Catering & Events</h3>
          <p class="card-meta">Planning a special event? We cater weddings, birthdays, corporate events, and more.</p>
          {contact?.contactPhone ? (
            <a
              href={`tel:${contact.contactPhone}`}
              class="mt-6 inline-flex items-center justify-center rounded-2xl bg-accent px-6 py-3 text-base font-semibold text-accent-foreground transition-colors hover:bg-accent/90"
            >
              Call for Catering
            </a>
          ) : null}
        </div>
      </div>

      <div class="card-base self-start bg-section-bg shadow-none">
        <h3 class="card-title mb-5 leading-none">Find Us</h3>
        <div class="overflow-hidden rounded-2xl border border-border min-h-[340px] bg-secondary lg:min-h-[420px]">
          {mapUrl ? (
            <iframe
              title="Map"
              src={mapUrl}
              class="w-full h-full min-h-[340px] lg:min-h-[420px]"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          ) : (
            <div class="w-full h-full min-h-[340px] lg:min-h-[420px] bg-secondary"></div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
