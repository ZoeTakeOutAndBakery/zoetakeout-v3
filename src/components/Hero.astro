---
import heroImage from "../assets/hero-bakery.jpg";
const { heading, subhead, primaryCta, secondaryCta } = Astro.props;
---
<section class="relative h-[calc(100svh-4rem)] min-h-[calc(100svh-4rem)] flex items-center justify-center overflow-hidden">
  <img
    src={heroImage.src}
    alt="Bakery storefront"
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
    decoding="async"
  />
  <div class="absolute inset-0 bg-black/30"></div>

  <div class="relative z-10 text-center text-primary-foreground px-4 max-w-4xl mx-auto">
    <div class="space-y-8">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-tight">
        {heading || "Zoe Take Out"}
        <br />
        <span class="text-accent">
          &amp; Bakery
        </span>
      </h1>

      <p class="text-xl md:text-2xl text-primary-foreground/90 max-w-2xl mx-auto leading-relaxed">
        {subhead || "Fresh-baked goods, delicious meals, and catering for life's special moments"}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-6">
        <a
          href={primaryCta?.url || "/menu"}
          class="inline-flex items-center justify-center rounded-md bg-accent px-8 py-3 text-lg font-semibold text-accent-foreground shadow-lg transition-colors hover:bg-accent/90"
        >
          {primaryCta?.text || "View Our Menu"}
        </a>
        <a
          href={secondaryCta?.url || "/#hours"}
          class="inline-flex items-center justify-center rounded-md border border-primary-foreground/50 px-8 py-3 text-lg font-semibold text-primary-foreground transition-colors hover:bg-primary-foreground/10"
        >
          {secondaryCta?.text || "Hours & Info"}
        </a>
      </div>
    </div>
  </div>
</section>
