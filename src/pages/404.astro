---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page Not Found" canonical={Astro.url}>
  <main class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-primary mb-4">404</h1>
      <p class="text-muted-foreground mb-6">The page you are looking for does not exist.</p>
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-md border border-border px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-secondary"
      >
        Back to Home
      </a>
    </div>
  </main>
</BaseLayout>
